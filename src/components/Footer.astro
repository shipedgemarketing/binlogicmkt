---
const socialLinks = [
	{
		label: "Facebook",
		href: "#",
		icon: "facebook",
	},
	{
		label: "Instagram",
		href: "#",
		icon: "instagram",
	},
	{
		label: "LinkedIn",
		href: "#",
		icon: "linkedin",
	},
	{
		label: "YouTube",
		href: "#",
		icon: "youtube",
	},
];
---

<footer class="bg-[#0A67AA] text-white">
	<div class="mx-auto flex max-w-7xl flex-col items-center px-6 pb-5 pt-10 md:px-8 md:pb-6 md:pt-12">
		<div class="flex flex-col items-center gap-8">
			<img
				src="/logos/logoBottom.png"
				alt="Binlogic"
				class="h-12 w-auto md:h-14"
			/>

			<div class="flex flex-wrap items-center justify-center gap-6 md:gap-8">
				{
					socialLinks.map((link) => (
						<a
							href={link.href}
							aria-label={link.label}
							class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-white text-[#0A67AA] transition hover:bg-[#E8F3FB]"
						>
							{
								link.icon === "facebook" && (
									<svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
										<path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.2-1.6 1.5-1.6H16V4.8c-.2 0-.9-.1-1.9-.1-2.9 0-4.6 1.8-4.6 4.9V11H7v3h2.5v7h4Z" />
									</svg>
								)
							}
							{
								link.icon === "instagram" && (
									<svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
										<path d="M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm0 1.8A2.7 2.7 0 0 0 4.8 7.5v9a2.7 2.7 0 0 0 2.7 2.7h9a2.7 2.7 0 0 0 2.7-2.7v-9a2.7 2.7 0 0 0-2.7-2.7h-9Zm9.45 1.35a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1ZM12 7.8A4.2 4.2 0 1 1 7.8 12 4.2 4.2 0 0 1 12 7.8Zm0 1.8A2.4 2.4 0 1 0 14.4 12 2.4 2.4 0 0 0 12 9.6Z" />
									</svg>
								)
							}
							{
								link.icon === "linkedin" && (
									<svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
										<path d="M6.4 8.1a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2ZM4.9 9.6H8V19H4.9V9.6Zm5 0h3v1.3h.1c.4-.8 1.5-1.6 3.2-1.6 3.4 0 4 2.2 4 5.1V19h-3.1v-4.1c0-1 0-2.3-1.4-2.3s-1.6 1.1-1.6 2.2V19H9.9V9.6Z" />
									</svg>
								)
							}
							{
								link.icon === "youtube" && (
									<svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
										<path d="M21.6 8.2a2.9 2.9 0 0 0-2-2C17.8 5.7 12 5.7 12 5.7s-5.8 0-7.6.5a2.9 2.9 0 0 0-2 2 30 30 0 0 0-.5 3.8c0 1.3.2 2.6.5 3.8a2.9 2.9 0 0 0 2 2c1.8.5 7.6.5 7.6.5s5.8 0 7.6-.5a2.9 2.9 0 0 0 2-2 30 30 0 0 0 .5-3.8c0-1.3-.2-2.6-.5-3.8ZM10.2 15.1V8.9l5.1 3.1-5.1 3.1Z" />
									</svg>
								)
							}
						</a>
					))
				}
			</div>
		</div>

		<div class="mt-10 w-full border-t border-white/80 pt-4 text-center text-sm font-medium md:mt-12 md:text-base">
			<p>&copy; 2025 BinLogic. All rights reserved.</p>
		</div>
	</div>
</footer>